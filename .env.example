# Market Cycle Trader API - isolated Tiingo market-data test
# Copy this file to .env and fill only local/secret values there.

# MongoDB
MONGO_URL=
MONGO_DATABASE=

# Primary market-data provider for this branch.
# The persisted Strategy can still contain market_data_provider=alpaca;
# this environment override is intentionally branch-local.
MCT_MARKET_DATA_PROVIDER=tiingo

# Tiingo REST API
TIINGO_API_KEY=
TIINGO_BASE_URL=https://api.tiingo.com
TIINGO_TIMEOUT_SECONDS=30
TIINGO_MAX_RETRIES=3
# Only wait automatically for short Retry-After windows. Hourly quota exhaustion
# fails fast so the already-cached bootstrap can be resumed after the reset.
TIINGO_MAX_RATE_LIMIT_WAIT_SECONDS=120

# Tiingo EOD is intentionally considered safe only after this delay from
# regular XNYS close. 240 minutes ~= 8 PM New York, allowing late corrections.
TIINGO_DAILY_BAR_DELAY_MINUTES=240

# Alpaca remains optional as the broker/paper-trading integration.
# It is no longer the primary historical market-data source when
# MCT_MARKET_DATA_PROVIDER=tiingo.
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=


# Model compute accelerator fallback.
# Persisted Backtest/MongoDB values take precedence when present.
# Accepted values: auto, cpu, cuda.
# On Windows, LightGBM maps cuda intent to its OpenCL GPU backend (device_type=gpu).
MCT_ROTATION_ACCELERATOR=auto
MCT_ROTATION_ALLOW_CPU_FALLBACK=true
