MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=extrema_backtest
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173

# Alpaca paper order execution. The code always instantiates TradingClient with paper=True.
ALPACA_PAPER_TRADING_ENABLED=false
# ALPACA_PAPER_ACCOUNT_ID is no longer required; the setup API binds the account.
# ALPACA_PAPER_ACCOUNT_ID=

# Protected HTTP control plane for next-session paper execution.
# Use a long random value and send it only in X-Paper-Market-Token.
PAPER_MARKET_API_TOKEN=
PAPER_MARKET_POLL_SECONDS=10
PAPER_MARKET_PREPARE_RETRY_SECONDS=60

# Protected idempotent parameter bootstrap API.
# The endpoint inserts only missing _id=default documents and never overwrites existing values.
PARAMETER_BOOTSTRAP_API_TOKEN=
